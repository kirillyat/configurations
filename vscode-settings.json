{
  // Editor and source review alongside Codex.
  "chat.disableAIFeatures": true,
  "workbench.startupEditor": "none",
  "workbench.editor.highlightModifiedTabs": true,
  "editor.minimap.enabled": false,
  "editor.largeFileOptimizations": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "git.autofetch": true,
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true
  },
  // Enable discovery: prefer the project's environment, otherwise use global Python.
  "python.defaultInterpreterPath": "python",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // Bundled formatters do not need packages in global Python.
  "black-formatter.importStrategy": "useBundled",
  "isort.importStrategy": "useBundled",
  "isort.args": ["--profile", "black"],
  // clangd provides C++ completion; cpptools remains available for debugging.
  "C_Cpp.intelliSenseEngine": "disabled",
  "go.testOnSave": false,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "zsh": { "path": "/bin/zsh", "args": ["-l"] }
  },
  "code-runner.executorMap": {
    "python": "\"$pythonPath\" -u"
  }
}
