{
  // Merged into User settings; personal themes, accounts and workspace choices stay.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // Bundled formatters do not need packages in global Python.
  "black-formatter.importStrategy": "useBundled",
  "isort.importStrategy": "useBundled",
  "isort.args": ["--profile", "black"],
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "zsh": { "path": "/bin/zsh", "args": ["-l"] }
  },
  "code-runner.executorMap": {
    "python": "\"$pythonPath\" -u"
  }
}
